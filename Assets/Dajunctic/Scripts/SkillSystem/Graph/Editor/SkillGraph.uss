.node #extension {
    background-color: #3f3f3f;
    padding: 5px;
}

.edge {
    --edge-color: #00ffff;
    --selected-edge-color: #ffffff;
    --ghost-edge-color: rgba(0, 255, 255, 0.5);
    --edge-width: 2;
}

.port.input {
    --port-color: #00ff00;
}

.port.output {
    --port-color: #ff0000;
}

.port #type {
    display: none;
}
