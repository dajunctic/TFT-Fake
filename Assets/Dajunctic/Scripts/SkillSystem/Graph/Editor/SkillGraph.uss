GridBackground {
    --grid-background-color: #2b2b2b;
    --line-color: rgba(51, 51, 51, 0.4);
    --thick-line-color: rgba(51, 51, 51, 1);
    --spacing: 15;
}

.node #extension {
    background-color: #3f3f3f;
    padding: 5px;
}

.edge {
    --edge-color: #00ffff;
    --selected-edge-color: #ffffff;
    --ghost-edge-color: rgba(0, 255, 255, 0.5);
    --edge-width: 2;
}

